IDD_MFC_GLOWINGBUTTONTEST_DIALOG DIALOGEX 0, 0, 460, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_SIZEBOX
CAPTION "MFC Glowing Button Example"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    CONTROL         "Normal",IDC_BTN_NORMAL,"Button",BS_OWNERDRAW | WS_TABSTOP,20,16,130,26
    CONTROL         "Rainbow",IDC_BTN_RAINBOW,"Button",BS_OWNERDRAW | WS_TABSTOP,165,16,130,26
    CONTROL         "Rounded",IDC_BTN_ROUNDED,"Button",BS_OWNERDRAW | WS_TABSTOP,310,16,130,26

    CONTROL         "No Border",IDC_BTN_NO_BORDER,"Button",BS_OWNERDRAW | WS_TABSTOP,20,52,130,26
    CONTROL         "Blue Border",IDC_BTN_BLUE_BORDER,"Button",BS_OWNERDRAW | WS_TABSTOP,165,52,130,26
    CONTROL         "Green Hover",IDC_BTN_GREEN_HOVER,"Button",BS_OWNERDRAW | WS_TABSTOP,310,52,130,26

    CONTROL         "Orange Press",IDC_BTN_ORANGE_PRESS,"Button",BS_OWNERDRAW | WS_TABSTOP,20,88,130,26
    CONTROL         "Pill Shape",IDC_BTN_PILL,"Button",BS_OWNERDRAW | WS_TABSTOP,165,88,130,26
    CONTROL         "Flat Dark",IDC_BTN_FLAT_DARK,"Button",BS_OWNERDRAW | WS_TABSTOP,310,88,130,26

    CONTROL         "Accent",IDC_BTN_ACCENT,"Button",BS_OWNERDRAW | WS_TABSTOP,20,124,130,26
    CONTROL         "Disabled",IDC_BTN_DISABLED,"Button",BS_OWNERDRAW | WS_TABSTOP,165,124,130,26
    CONTROL         "Toggle Rainbow",IDC_BTN_TOGGLE_RAINBOW,"Button",BS_OWNERDRAW | WS_TABSTOP,310,124,130,26

    DEFPUSHBUTTON   "Close",IDOK,200,230,60,18
END

