IDD_MFC_GLOWINGBUTTONTEST_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MFC Glowing Button Example"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    CONTROL         "Normal",IDC_BTN_NORMAL,"Button",BS_OWNERDRAW | WS_TABSTOP,20,20,120,28
    CONTROL         "Rainbow",IDC_BTN_RAINBOW,"Button",BS_OWNERDRAW | WS_TABSTOP,160,20,120,28
    CONTROL         "Rounded",IDC_BTN_ROUNDED,"Button",BS_OWNERDRAW | WS_TABSTOP,20,60,120,28
    CONTROL         "Disabled",IDC_BTN_DISABLED,"Button",BS_OWNERDRAW | WS_TABSTOP,160,60,120,28
    CONTROL         "Toggle",IDC_BTN_TOGGLE_RAINBOW,"Button",BS_OWNERDRAW | WS_TABSTOP,90,110,140,32
    DEFPUSHBUTTON   "Close",IDOK,130,160,60,18
END

